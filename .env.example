PORT=15600
HOST=127.0.0.1
# Exact additional HTTP Host names; requires LOCAL_API_KEY. No wildcard/CORS.
# TRUSTED_HOSTS=host.docker.internal
# Application keys: unique ID + >=24-character random key; admin key required.
# APP_API_KEYS='[{"id":"my-app","key":"replace-with-a-long-random-application-key"}]'
DEFAULT_MODEL=gpt-6-luna
DEFAULT_REASONING_EFFORT=low
REQUEST_TIMEOUT_MS=180000
MAX_CONCURRENT=2
# Opt-in bounded FIFO; 0 keeps immediate 429 when all slots are busy.
MAX_QUEUE=0
QUEUE_TIMEOUT_MS=30000
MAX_SESSIONS=100
SESSION_TTL_MS=86400000
DATA_DIR=.local
# Defaults to DATA_DIR/stats.sqlite; history is kept across restarts.
# STATS_DB_PATH=.local/stats.sqlite
# Optional local gateway token; this is NOT an OpenAI API key.
# LOCAL_API_KEY=replace-with-a-random-secret
# Optional absolute path to a compatible native Codex CLI. Defaults to the SDK's bundled CLI.
# CODEX_BIN=/absolute/path/to/codex

# Native Codex observer (read-only). Defaults to CODEX_HOME or ~/.codex.
# NATIVE_CODEX_HOME=/Users/yourname/.codex
NATIVE_USAGE_INTERVAL_MS=30000

# Opt-in request inspector. Bodies stay in separate redacted JSON files, never SQLite.
# Playground remains ephemeral even when enabled. Restart required.
INSPECTOR_ENABLED=false
INSPECTOR_RETENTION_MS=86400000
# Per-call snapshot byte ceiling; oversized segments are explicitly marked unavailable.
INSPECTOR_MAX_BYTES=8388608

# Phase 3: opt-in local providers. Origins only (do not append /v1 or /api).
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# LM_STUDIO_BASE_URL=http://127.0.0.1:1234
# Separate backend keys, never gateway/ChatGPT credentials.
# OLLAMA_API_KEY=your-ollama-server-key
# LM_STUDIO_API_KEY=your-lm-studio-server-key
# Optional exact extra backend hosts/IPs, no wildcards. Redirects are rejected.
# LOCAL_PROVIDER_HOSTS=host.docker.internal
LOCAL_PROVIDER_TIMEOUT_MS=180000
# openai uses /v1; v0 explicitly uses LM Studio /api/v0 for reported stats.
LM_STUDIO_API=openai
# Optional verified process IDs on THIS host, only for loopback provider URLs.
# OLLAMA_PID=12345
# LM_STUDIO_PID=12346
# Benchmarks use admin auth. Codex requires both this opt-in and batch acknowledgement.
LAB_ALLOW_CODEX=false
LAB_MAX_REQUESTS_PER_DAY=200
LAB_RETENTION_DAYS=7
LAB_MIN_INTERVAL_MS=1000
